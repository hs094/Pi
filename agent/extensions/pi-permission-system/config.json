{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git *": "allow",
      "git branch * ": "deny",
      "git stash": {
        "action": "deny",
        "reason": "Stashing hides changes; use temporary branches instead"
      },
      "git stash *": {
        "action": "deny",
        "reason": "Stashing hides changes; use temporary branches instead"
      },
      "git commit": {
        "action": "deny",
        "reason": "Direct commits restricted"
      },
      "git commit *": {
        "action": "deny",
        "reason": "Direct commits restricted"
      },
      "git push": {
        "action": "deny",
        "reason": "Direct push restricted"
      },
      "git push *": {
        "action": "deny",
        "reason": "Direct push restricted"
      },
      "git merge *": {
        "action": "deny",
        "reason": "Direct merge restricted"
      },
      "git rebase *": {
        "action": "deny",
        "reason": "Rebase can rewrite history"
      },
      "git reset *": {
        "action": "deny",
        "reason": "Reset can destroy work"
      },
      "git clean *": {
        "action": "deny",
        "reason": "Clean destroys untracked files"
      },
      "rm -rf *": "deny",
      "sudo *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "chmod *": "ask",
      "chown *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.npm/*": "allow",
      "~/.cargo/registry/*": "allow",
      "~/go/pkg/mod/*": "allow"
    }
  }
}
