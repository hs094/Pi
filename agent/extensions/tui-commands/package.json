{
  "name": "pi-tui-commands",
  "version": "0.1.0",
  "description": "Interactive / command registry for pi \u2014 register any TUI tool as a slash command with binary-availability checks",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "lazygit",
    "interactive"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://pi.dev/logo-auto.svg"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-strip-types terminal-view.test.ts",
    "postinstall": "node scripts/fix-pty-helper.cjs"
  },
  "files": [
    "*.ts",
    "*.json",
    "README.md",
    "LICENSE",
    "scripts/"
  ],
  "devDependencies": {
    "prettier": "^3.9.5"
  },
  "type": "module",
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
