{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+read",
    "+bash",
    "+edit",
    "+write",
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "codemode": {
    "mode": "only",
    "inlineBudget": 1000
  },
  "packages": [
    "npm:pi-rewind",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-tui-commands",
    "npm:@superwhisper/pi",
    "npm:pi-web-access",
    "npm:pi-markdown-preview",
    "npm:pi-context-view",
    "npm:@adeildo/pi-look",
    "npm:pi-permissions",
    "npm:pi-output-limits"
  ],
  "quietStartup": true,
  "theme": "github-dark-default",
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "all",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ],
  "compaction": {
    "enabled": true
  },
  "extensions": [
    "-builtin:mcp"
  ],
  "markdown": {
    "mermaid": "streaming"
  },
  "doubleEscapeAction": "tree",
  "outputLimits": {
    "maxLines": 500,
    "maxBytes": 16384,
    "tools": {
      "bash": { "maxLines": 300, "maxBytes": 8192 }
    },
    "tailTools": ["bash"]
  }
}
