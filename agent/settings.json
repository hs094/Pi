{
  "lastChangelogVersion": "1.5.2",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+read",
    "+bash",
    "+edit",
    "+write",
    "+grep",
    "+find",
    "+ls",
    "+codemode"
  ],
  "codemode": {
    "mode": "only",
    "inlineBudget": 2000
  },
  "packages": [
    "npm:pi-rewind",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-tui-commands",
    "npm:pi-web-access",
    "npm:pi-context-view",
    "npm:@adeildo/pi-look",
    "npm:pi-output-limits",
    "npm:pi-md-preview@0.5.0"
  ],
  "quietStartup": true,
  "theme": "github-dark-default",
  "collapseChangelog": true,
  "showHardwareCursor": true,
  "steeringMode": "one-at-a-time",
  "terminal": {
    "showTerminalProgress": true
  },
  "treeFilterMode": "all",
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "tuiMode": "fullscreen",
  "enabledModels": [
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ],
  "compaction": {
    "enabled": true
  },
  "markdown": {
    "mermaid": "streaming"
  },
  "doubleEscapeAction": "tree",
  "outputLimits": {
    "maxLines": 300,
    "maxBytes": 8192,
    "tailTools": [
      "bash"
    ]
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0",
    "{\"source\":\"npm:pi-context-view\",\"scope\":\"user\"}": "0.8.3"
  }
}
